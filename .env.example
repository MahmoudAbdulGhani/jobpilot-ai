# JobPilot AI - environment template
#
# Copy this file to .env and fill in real values:
#   Copy-Item .env.example .env
#
# NEVER commit your real .env file. It is already ignored by .gitignore.

APP_NAME="JobPilot AI"

# One of: local, test, production
ENVIRONMENT="local"
JOBPILOT_DEBUG="true"

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS="http://localhost:3000"

# REQUIRED. Secret used to sign authentication tokens (needed from Phase 1e).
# There is no safe default, so the app refuses to start without it.
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""

# ---- PostgreSQL (local development via Docker Compose) ----
# Used by docker-compose.yml. The database listens on 127.0.0.1 only.
# Generate a strong password with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER="jobpilot"
POSTGRES_PASSWORD=""
POSTGRES_DB="jobpilot"
POSTGRES_TEST_DB="jobpilot_test"
POSTGRES_PORT="5433"

# Keep disabled for development. The Playwright harness enables this only on
# its isolated backend, where POSTGRES_DB must also equal POSTGRES_TEST_DB.
E2E_TEST_MODE="false"

# Local PDF/DOCX text extraction safety limits.
RESUME_EXTRACTION_TIMEOUT_SECONDS="15"
RESUME_EXTRACTION_MAX_CHARS="200000"
RESUME_EXTRACTION_MAX_PAGES="100"
RESUME_EXTRACTION_MAX_BLOCKS="10000"

# Optional AI profile suggestions. Disabled until explicitly configured.
JOBPILOT_AI_ENABLED="false"
# Explicit provider selection; adding either key alone never enables AI.
JOBPILOT_AI_PROVIDER="openai"
# OpenAI model (retained when switching providers).
JOBPILOT_AI_MODEL="gpt-5-mini"
JOBPILOT_OPENAI_API_KEY=""
# Groq uses the existing SDK with its own endpoint and credentials.
JOBPILOT_GROQ_MODEL="openai/gpt-oss-20b"
JOBPILOT_GROQ_API_KEY=""
JOBPILOT_AI_TIMEOUT_SECONDS="30"
JOBPILOT_AI_MAX_INPUT_CHARS="100000"
JOBPILOT_AI_MAX_OUTPUT_TOKENS="4000"
JOBPILOT_AI_MAX_REQUESTS_PER_USER="20"
# Never enable outside the guarded Playwright/pytest test database.
JOBPILOT_AI_TEST_PROVIDER="false"

# Seconds to wait for a database TCP connection before giving up.
# Kept small on purpose so a stopped database fails fast instead of hanging.
POSTGRES_CONNECT_TIMEOUT="3"

# ---- Authentication (Phase 1e) ----
ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# false is correct for local HTTP development (http://localhost).
# In production this MUST be true: the app refuses to start otherwise,
# because the refresh cookie must never travel over plaintext HTTP.
AUTH_COOKIE_SECURE="false"

# Independent application-pack defaults; shared AI enablement and user usage limits still apply.
JOBPILOT_PACK_PROVIDER="openai"
JOBPILOT_PACK_MODEL="gpt-5-mini"
JOBPILOT_PACK_REASONING_EFFORT="minimal"
JOBPILOT_PACK_MAX_OUTPUT_TOKENS="4000"
JOBPILOT_PACK_TIMEOUT_SECONDS="60"

# JobTech open-data discovery: no API key required. Synthetic mode is guarded by E2E_TEST_MODE/test DB.
JOBPILOT_DISCOVERY_ENABLED="true"
JOBPILOT_DISCOVERY_TEST_PROVIDER="false"

# Gmail OAuth foundation. Populate only in private environment; never commit secrets.
JOBPILOT_GOOGLE_CLIENT_ID=""
JOBPILOT_GOOGLE_CLIENT_SECRET=""
JOBPILOT_GOOGLE_REDIRECT_URI=""
JOBPILOT_MAILBOX_SETTINGS_URL=""
JOBPILOT_MAILBOX_ENCRYPTION_KEY=""
JOBPILOT_MAILBOX_TEST_PROVIDER="false"

# Text interview practice only; reuses the server-side OpenAI key and shared AI quota.
JOBPILOT_INTERVIEW_PROVIDER=openai
JOBPILOT_INTERVIEW_MODEL=gpt-5-mini
JOBPILOT_INTERVIEW_REASONING_EFFORT=minimal
JOBPILOT_INTERVIEW_MAX_OUTPUT_TOKENS=2000
JOBPILOT_INTERVIEW_TIMEOUT_SECONDS=60
JOBPILOT_INTERVIEW_MAX_INPUT_BYTES=32000
JOBPILOT_INTERVIEW_MAX_CALLS_PER_SESSION=10
JOBPILOT_INTERVIEW_MAX_SESSIONS_PER_USER=20

# Optional speech input/playback; separate backend key, disabled by default.
JOBPILOT_VOICE_ENABLED=false
JOBPILOT_VOICE_PROVIDER=openai
JOBPILOT_VOICE_TRANSCRIPTION_MODEL=whisper-1
JOBPILOT_VOICE_SPEECH_MODEL=tts-1
JOBPILOT_VOICE_API_KEY=
JOBPILOT_VOICE_TEST_PROVIDER=false
JOBPILOT_VOICE_MAX_SECONDS=60
JOBPILOT_VOICE_TIMEOUT_SECONDS=30
JOBPILOT_VOICE_MAX_CALLS_PER_SESSION=18
JOBPILOT_VOICE_TRANSCRIPT_MINUTES=10

## Account onboarding (separate from Gmail application mailboxes)
JOBPILOT_REGISTRATION=invite-only
JOBPILOT_ACCOUNT_APP_URL=
JOBPILOT_ACCOUNT_MAIL_TRANSPORT=disabled
JOBPILOT_ACCOUNT_MAIL_FROM=
JOBPILOT_ACCOUNT_SMTP_HOST=
JOBPILOT_ACCOUNT_SMTP_PORT=465
JOBPILOT_ACCOUNT_SMTP_USER=
JOBPILOT_ACCOUNT_SMTP_PASSWORD=

# Account data: no external provider is required for exports. Cleanup must be scheduled.
ACCOUNT_EXPORT_MAX_MIB=25
ACCOUNT_EXPORT_MAX_ROWS=10000
ACCOUNT_EXPORT_MINUTES=10
ACCOUNT_TOKEN_RETENTION_DAYS=1
ACCOUNT_OPERATION_RETENTION_DAYS=30
ACCOUNT_EMAIL_PREVIEW_DAYS=90
