# Backend environment only; never populate this tracked template with secrets.
ENVIRONMENT=production
JOBPILOT_DEBUG=false
SECRET_KEY=
JOBPILOT_APP_URL=
CORS_ORIGINS=
ALLOWED_HOSTS=
# Empty disables trust of forwarded headers. Never use * or internet-wide CIDRs.
JOBPILOT_PROXY_IPS=
AUTH_COOKIE_SECURE=true
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
JOBPILOT_STORAGE=supabase
JOBPILOT_STORAGE_URL=
JOBPILOT_STORAGE_BUCKET=
JOBPILOT_STORAGE_KEY=
JOBPILOT_REGISTRATION=invite-only
JOBPILOT_ACCOUNT_MAIL_TRANSPORT=disabled
JOBPILOT_ACCOUNT_APP_URL=
JOBPILOT_ACCOUNT_SMTP_HOST=
JOBPILOT_ACCOUNT_MAIL_FROM=
JOBPILOT_ACCOUNT_SMTP_USER=
JOBPILOT_ACCOUNT_SMTP_PASSWORD=
JOBPILOT_AI_ENABLED=false
JOBPILOT_OPENAI_API_KEY=
JOBPILOT_GOOGLE_CLIENT_ID=
JOBPILOT_GOOGLE_CLIENT_SECRET=
JOBPILOT_GOOGLE_REDIRECT_URI=
JOBPILOT_MAILBOX_SETTINGS_URL=
JOBPILOT_MAILBOX_ENCRYPTION_KEY=
E2E_TEST_MODE=false
JOBPILOT_AI_TEST_PROVIDER=false
JOBPILOT_MAILBOX_TEST_PROVIDER=false
JOBPILOT_DISCOVERY_TEST_PROVIDER=false
