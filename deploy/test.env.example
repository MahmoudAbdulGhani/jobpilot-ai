# Explicit isolated test process; never copy production credentials here.
ENVIRONMENT=test
SECRET_KEY=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=jobpilot_test
POSTGRES_TEST_DB=jobpilot_test
POSTGRES_SSLMODE=disable
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:3010
AUTH_COOKIE_SECURE=false
JOBPILOT_STORAGE=local
# Set RESUME_STORAGE_DIR to a dedicated temporary test directory.
JOBPILOT_ACCOUNT_MAIL_TRANSPORT=disabled
JOBPILOT_AI_ENABLED=false
E2E_TEST_MODE=false
# The existing Playwright harness explicitly guards and sets its own fixtures.
